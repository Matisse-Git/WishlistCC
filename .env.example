# SQLite for local dev (default): file:./dev.db
# Postgres for deployment: postgresql://user:password@host:5432/dbname?schema=public
DATABASE_URL="file:./dev.db"

# Optional: API key for a paid/higher-limit currency conversion provider.
# Leave unset to use the free https://open.er-api.com endpoint (no key required).
CURRENCY_API_KEY=

# Optional: public URL of the deployed app (used in a couple of absolute-link spots).
APP_URL="http://localhost:3000"

# Optional: set to enable a simple shared-password gate (see src/proxy.ts).
# Leave unset to run with no authentication (fine for local-only use).
APP_PASSWORD=
