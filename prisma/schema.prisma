// Prisma schema for WishListCC — a personal wishlist app.
// Default datasource is SQLite for cheap/free local development.
// See README.md "Deploying with PostgreSQL" for how to switch providers.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Singleton row (id always 1) holding user-wide preferences.
model Setting {
  id           Int      @id @default(autoincrement())
  baseCurrency String   @default("USD")
  goalAmount   Decimal?
  savedAmount  Decimal?
  updatedAt    DateTime @updatedAt
}

model Label {
  id        String      @id @default(cuid())
  name      String      @unique
  color     String?
  createdAt DateTime    @default(now())
  items     ItemLabel[]
}

model Group {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String?
  createdAt DateTime @default(now())
  items     Item[]
}

// Ties together a set of Items that are alternatives for the same slot
// (e.g. "650W PSU" vs "750W PSU") — only the member with isSelected=true
// counts toward wishlist/group totals. Row itself carries no data; it just
// anchors the relation so a set can be created/dissolved atomically. All
// invariants (exactly one isSelected per set, sets never shrink to 1
// member) are enforced in application code — see src/lib/variants.ts.
model VariantGroup {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  items     Item[]
}

model Item {
  id     String  @id @default(cuid())
  url    String?
  title  String
  description String?
  imageUrl    String?

  originalPrice    Decimal?
  originalCurrency String?
  convertedPrice   Decimal?
  baseCurrency     String?
  // "success" | "missing_rate" | "manual" | "not_needed" | "unknown"
  conversionStatus String @default("unknown")

  // "wishlist" | "bought"
  status   String @default("wishlist")
  // "low" | "medium" | "high"
  priority String?

  store String?
  notes String?

  boughtAt       DateTime?
  boughtPrice    Decimal?
  boughtCurrency String?

  rawMetadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  labels ItemLabel[]

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  // Variant sets: alternatives for the same purchase decision (see VariantGroup).
  // isSelected defaults true so plain, non-variant items are always counted.
  variantGroupId String?
  variantGroup   VariantGroup? @relation(fields: [variantGroupId], references: [id], onDelete: SetNull)
  isSelected     Boolean       @default(true)

  // Other places to buy this exact item — see PriceSource. Distinct from
  // variants: these aren't alternative products, just alternative listings
  // for the same one. The Item's own price/url/store fields above are
  // always "the active listing"; switching sources swaps that data with a
  // PriceSource row rather than changing which row is selected.
  priceSources PriceSource[]

  @@index([status])
  @@index([createdAt])
  @@index([groupId])
  @@index([variantGroupId])
}

// An alternate store/URL/price for an Item that isn't currently the active
// listing (see Item.priceSources). Activating one swaps its fields with the
// owning Item's own price fields — see src/lib/priceSources.ts.
model PriceSource {
  id     String @id @default(cuid())
  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  url              String?
  store            String?
  originalPrice    Decimal?
  originalCurrency String?
  convertedPrice   Decimal?
  baseCurrency     String?
  conversionStatus String  @default("unknown")

  createdAt DateTime @default(now())

  @@index([itemId])
}

model ItemLabel {
  itemId  String
  labelId String

  item  Item  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([itemId, labelId])
  @@index([labelId])
}

model ExchangeRateCache {
  id           String   @id @default(cuid())
  baseCurrency String   @unique
  rates        Json
  fetchedAt    DateTime @default(now())
  expiresAt    DateTime
}
